DB_DSN=postgres://fortistack:fortistaticpassword@postgres:5432/fortistack?sslmode=disable
JWT_SECRET=dev_secret_only
JWT_ISSUER=fortistack
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=168
API_BASE_URL=http://localhost:8080

# Worker Config
MONTHLY_CRON="0 0 1 * *"
CRON_TZ=Africa/Lagos

# SMTP Config
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=reports@fortistack.local

# ── Storage ────────────────────────────────────────
# STORAGE_DRIVER: "local" or "s3"
# Dev default = s3 (MinIO), Prod = s3 (Ceph RGW)
STORAGE_DRIVER=s3

# For STORAGE_DRIVER=local:
STORAGE_LOCAL_DIR=/app/workdir

# For STORAGE_DRIVER=s3 (works with MinIO / Ceph RGW / AWS S3):
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_BUCKET=fortistack
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_DISABLE_SSL=true

# ── Database (compose) ────────────────────────────
POSTGRES_USER=fortistack
POSTGRES_PASSWORD=fortistaticpassword
POSTGRES_DB=fortistack
